# Copie este arquivo para .env e substitua os valores fictícios.
# Nunca use estes valores em produção.

# PostgreSQL (conexão da aplicação)
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=seu_usuario_local
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_NAME=heroforce

# PostgreSQL (variáveis usadas pelo docker-compose.yml)
POSTGRES_PORT=5433
POSTGRES_USER=seu_usuario_local
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_DB=heroforce

# Autenticação e aplicação
JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
CLIENT_ORIGIN=http://localhost:3000
SERVER_PORT=3001

# Admin account created by `npm run seed` (required only when running the seed)
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
